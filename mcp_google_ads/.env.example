# Copia este archivo como .env y llena los valores.
# .env esta en .gitignore y NUNCA debe subirse al repositorio.
#
# Como se obtiene cada uno:
#
# DEVELOPER_TOKEN -> Google Ads > Herramientas > Configuracion > Centro de API.
#                    Con nivel "Basic access" alcanza para leer keywords.
#
# CLIENT_ID / CLIENT_SECRET -> console.cloud.google.com > APIs y servicios >
#                    Credenciales > Crear credenciales > ID de cliente de OAuth
#                    > Tipo: "Aplicacion de escritorio".
#
# REFRESH_TOKEN  -> se genera una sola vez corriendo:  node get_refresh_token.js
#
# CUSTOMER_ID    -> arriba a la derecha en la interfaz de Google Ads.
#                   Se puede escribir con o sin guiones.
#
# LOGIN_CUSTOMER_ID -> solo si la cuenta se administra desde una cuenta MCC.
#                      Es el ID de la MCC, no el de la cuenta final.

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
